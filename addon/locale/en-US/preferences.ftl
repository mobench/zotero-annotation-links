pref-title = Annotation Links
pref-link-template = Link template
pref-link-template-description = Text copied by "Copy Annotation Link" and Ctrl+Shift+C. Placeholders like { "{link}" } and { "{page}" } are replaced with the annotation's values, e.g. { "[Page {page}]({link})" } copies a Markdown link.
pref-link-template-docs = All placeholders and examples
